//@version=6
strategy("ドル円 統合戦略 (A:東京レンジ→ロンドン + B:5時売り)", overlay=true, initial_capital=200000, default_qty_type=strategy.fixed, default_qty_value=10000, slippage=2, margin_long=4, margin_short=4)

tz     = input.string("Asia/Tokyo", "タイムゾーン")
startT = input.time(timestamp("2025-01-01T00:00:00"), "検証開始日")
endT   = input.time(timestamp("2026-05-31T23:59:00"), "検証終了日")

gA = "A: 東京レンジ→ロンドン"
gB = "B: 5時売り(時間帯バイアス)"

// ===== A =====
useA    = input.bool(true, "Aを使う", group=gA)
rS      = input.int(9,  "A レンジ開始時(含む)", minval=0, maxval=23, group=gA)
rE      = input.int(16, "A レンジ終了時(含まない)", minval=1, maxval=23, group=gA)
eE      = input.int(19, "A エントリー受付終了時(含まない)", minval=1, maxval=24, group=gA)
holdEnd = input.int(23, "A 強制決済時", minval=1, maxval=24, group=gA)
slRatio = input.float(0.5, "A 損切り(レンジ幅倍)", minval=0.1, step=0.1, group=gA)
tpRatio = input.float(0.6, "A 利確(レンジ幅倍)", minval=0.1, step=0.1, group=gA)

// ===== B =====
useB   = input.bool(true, "Bを使う", group=gB)
bH     = input.int(5, "B エントリー時(日本時間)", minval=0, maxval=23, group=gB)
bHold  = input.int(1, "B 保有時間(時間)", minval=1, maxval=12, group=gB)
bStop  = input.float(0.0, "B 損切り(pips、0=なし)", minval=0.0, step=1.0, group=gB)
bMon   = input.bool(false, "B 月", group=gB)
bTue   = input.bool(true,  "B 火", group=gB)
bWed   = input.bool(true,  "B 水", group=gB)
bThu   = input.bool(true,  "B 木", group=gB)
bFri   = input.bool(true,  "B 金", group=gB)

h = hour(time, tz)
d = dayofweek(time, tz)
inPeriod = time_close >= startT and time_close <= endT

// --- A: 東京レンジ ---
dayOkA  = d >= dayofweek.monday and d <= dayofweek.friday
inRange = h >= rS and h < rE

var float rH = na
var float rL = na
var bool tradedA = false
var bool aActive = false

if strategy.position_size == 0
    aActive := false

if inRange and not inRange[1]
    rH := high
    rL := low
    tradedA := false
else if inRange
    rH := math.max(rH, high)
    rL := math.min(rL, low)

rangeH  = rH - rL
inEntryA = useA and h >= rE and h < eE and dayOkA and inPeriod and not na(rH) and rangeH > 0

longA  = inEntryA and not tradedA and close > rH and strategy.position_size == 0
shortA = inEntryA and not tradedA and close < rL and strategy.position_size == 0

var float slP = na
var float tpP = na

if longA
    slP := rH - rangeH * slRatio
    tpP := rH + rangeH * tpRatio
    tradedA := true
    aActive := true
    strategy.entry("L", strategy.long, comment = "A")
if shortA
    slP := rL + rangeH * slRatio
    tpP := rL - rangeH * tpRatio
    tradedA := true
    aActive := true
    strategy.entry("S", strategy.short, comment = "A")

if strategy.position_size > 0 and aActive
    strategy.exit("XL", "L", stop = slP, limit = tpP)
if strategy.position_size < 0 and aActive
    strategy.exit("XS", "S", stop = slP, limit = tpP)

if strategy.position_size != 0 and aActive and (h >= holdEnd or h < rS)
    strategy.close_all(comment = "A時間外決済")

// --- B: 5時売り ---
hStart   = hour(time, tz)
hClose   = hour(time_close, tz)
boundary = hClose != hStart
dEntry   = dayofweek(time_close, tz)
bDayOk   = (dEntry == dayofweek.monday and bMon) or (dEntry == dayofweek.tuesday and bTue) or (dEntry == dayofweek.wednesday and bWed) or (dEntry == dayofweek.thursday and bThu) or (dEntry == dayofweek.friday and bFri)
bExitH   = (bH + bHold) % 24

bEnter = useB and boundary and hClose == bH and bDayOk and inPeriod and strategy.position_size == 0
bExit  = boundary and hClose == bExitH

if bEnter
    strategy.entry("BS", strategy.short, comment = "B")
if strategy.position_size < 0 and not aActive and bStop > 0
    strategy.exit("XBS", "BS", stop = strategy.position_avg_price + bStop * syminfo.mintick * 10)
if bExit and strategy.position_size < 0
    strategy.close("BS", comment = "B時間決済")

// --- 表示 ---
plot(useA ? rH : na, "A レンジ高値", color = color.new(color.green, 30), style = plot.style_linebr)
plot(useA ? rL : na, "A レンジ安値", color = color.new(color.red, 30), style = plot.style_linebr)
bgcolor(useA and inRange ? color.new(color.gray, 92) : na)
bgcolor(useA and h >= rE and h < eE ? color.new(color.blue, 92) : na)
bgcolor(useB and (hStart - bH + 24) % 24 < bHold ? color.new(color.yellow, 90) : na)

// --- 設定表(右上) ---
var table info = table.new(position.top_right, 2, 7, border_width = 1)
if barstate.islast
    periodText = str.format_time(startT, "yyyy-MM-dd", tz) + " ～ " + str.format_time(endT, "yyyy-MM-dd", tz)
    dayText    = (bMon ? "月" : "") + (bTue ? "火" : "") + (bWed ? "水" : "") + (bThu ? "木" : "") + (bFri ? "金" : "")
    aText      = useA ? (str.tostring(rS) + "〜" + str.tostring(rE) + "時レンジ / 受付" + str.tostring(rE) + "〜" + str.tostring(eE) + "時") : "OFF"
    bText      = useB ? (str.tostring(bH) + "時 売り " + str.tostring(bHold) + "時間") : "OFF"
    stopText   = bStop > 0 ? (str.tostring(bStop) + " pips") : "なし"
    ratioText  = str.tostring(slRatio) + " / " + str.tostring(tpRatio)

    table.cell(info, 0, 0, "足", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(info, 1, 0, timeframe.period, text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small)
    table.cell(info, 0, 1, "検証期間", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(info, 1, 1, periodText, text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small)
    table.cell(info, 0, 2, "A", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(info, 1, 2, aText, text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small)
    table.cell(info, 0, 3, "A 損切り/利確", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(info, 1, 3, ratioText, text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small)
    table.cell(info, 0, 4, "B", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(info, 1, 4, bText, text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small)
    table.cell(info, 0, 5, "B 曜日", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(info, 1, 5, dayText, text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small)
    table.cell(info, 0, 6, "B 損切り", text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
    table.cell(info, 1, 6, stopText, text_color = color.white, bgcolor = color.new(color.black, 20), text_size = size.small)